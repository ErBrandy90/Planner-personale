{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Planner Settimanale",
  "version": "0.4.0",
  "identifier": "it.planner.settimanale",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Planner Settimanale",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 630,
        "resizable": true,
        "backgroundColor": "#e8e7e2"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk0MTU5NDcwQTQ2RkRDNTgKUldSWTNHK2tjSlFWbE1HS3YxaTRIaUVRRzl2bExsRS96QnVUV0lWeW1FVnZOQ2RlOGh4bVNuQ1EK",
      "windows": {
        "installMode": "passive"
      },
      "endpoints": [
        "https://github.com/ErBrandy90/Planner-personale/releases/latest/download/latest.json"
      ]
    }
  }
}
