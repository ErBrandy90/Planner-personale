{
  "name": "planner-settimanale",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc -b && vite build --configLoader runner",
    "typecheck": "tsc -b",
    "versione": "node scripts/versione.mjs",
    "format": "prettier --write src scripts && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check src scripts && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prettier": "3.9.10",
    "typescript": "~5.9.2",
    "vite": "^7.1.0"
  }
}
